<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xerces="http://xerces.apache.org"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      XSD 1.1 schema for D365FO EDT metadata (AxEdt).
      Validated by Xerces-J (xsd11 mode).

      Design: XSD 1.1 xs:all extension merging.
        - AxEdtBaseType (abstract) holds the 12 elements shared by ALL EDT types.
        - Each concrete type (AxEdtString, AxEdtEnum, ...) extends AxEdtBaseType
          with an xs:all containing its type-specific elements.
        - XSD 1.1 merges the two xs:all groups into a single flat unordered set,
          so all elements from both the base and the extension may appear in any order.
        - The root element AxEdt uses XSD 1.1 xs:alternative dispatch on xsi:type.
          A fallback alternative provides an explicit allowed-types message.
        - Name, ArrayElements, Relations, and TableReferences are required by element cardinality.
        - Additional XSD 1.1 asserts are used to provide friendlier diagnostics for common data issues.
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="AxBooleanLikeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="0"/>
      <xs:enumeration value="Yes"/>
      <xs:enumeration value="No"/>
      <xs:enumeration value="yes"/>
      <xs:enumeration value="no"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="AxEdtCollectionType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

    <!-- Abstract base: elements shared by ALL EDT types. -->
  <xs:complexType name="AxEdtBaseType" abstract="true">
    <xs:all>
      <xs:element name="Name" type="xs:string"/>
      <xs:element name="DisplayLength" type="xs:integer" minOccurs="0"/>
      <xs:element name="Extends" type="xs:string" minOccurs="0"/>
      <xs:element name="Label" type="xs:string" minOccurs="0"/>
      <xs:element name="ConfigurationKey" type="xs:string" minOccurs="0"/>
      <xs:element name="CountryRegionCodes" type="xs:string" minOccurs="0"/>
      <xs:element name="HelpText" type="xs:string" minOccurs="0"/>
      <xs:element name="ArrayElements" type="AxEdtCollectionType"/>
      <xs:element name="Relations" type="AxEdtCollectionType"/>
      <xs:element name="TableReferences" type="AxEdtCollectionType"/>
      <xs:element name="ReferenceTable" type="xs:string" minOccurs="0"/>
      <xs:element name="IsObsolete" type="AxBooleanLikeType" minOccurs="0"/>
    </xs:all>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
    <xs:assert
      test="normalize-space(Name) ne ''"
      xerces:message="AxEdt/Name must not be empty or whitespace."/>
  </xs:complexType>

  <xs:complexType name="AxEdtString">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="ButtonImage" type="xs:string" minOccurs="0"/>
          <xs:element name="DisplayHeight" type="xs:integer" minOccurs="0"/>
          <xs:element name="Alignment" type="xs:string" minOccurs="0"/>
          <xs:element name="FormHelp" type="xs:string" minOccurs="0"/>
          <xs:element name="Tags" type="xs:string" minOccurs="0"/>
          <xs:element name="CollectionLabel" type="xs:string" minOccurs="0"/>
          <xs:element name="PresenceIndicatorAllowed" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="EnforceHierarchy" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="Direction" type="xs:string" minOccurs="0"/>
          <xs:element name="PresenceMethod" type="xs:string" minOccurs="0"/>
          <xs:element name="PresenceClass" type="xs:string" minOccurs="0"/>
          <xs:element name="ControlClass" type="xs:string" minOccurs="0"/>
          <xs:element name="StringSize" type="xs:integer" minOccurs="0"/>
          <xs:element name="ChangeCase" type="xs:string" minOccurs="0"/>
          <xs:element name="StringSizeIsExtensible" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="DatabaseStringSize" type="xs:integer" minOccurs="0"/>
          <xs:element name="Adjustment" type="xs:string" minOccurs="0"/>
          <xs:element name="DataInteractorFactory" type="xs:string" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtEnum">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="EnforceHierarchy" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="Tags" type="xs:string" minOccurs="0"/>
          <xs:element name="CollectionLabel" type="xs:string" minOccurs="0"/>
          <xs:element name="PresenceIndicatorAllowed" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="EnumType" type="xs:string" minOccurs="0"/>
          <xs:element name="Style" type="xs:string" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtReal">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="AllowNegative" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="ShowZero" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="EnforceHierarchy" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="Alignment" type="xs:string" minOccurs="0"/>
          <xs:element name="SignDisplay" type="xs:string" minOccurs="0"/>
          <xs:element name="RotateSign" type="xs:string" minOccurs="0"/>
          <xs:element name="DisplaceNegative" type="xs:string" minOccurs="0"/>
          <xs:element name="NoOfDecimals" type="xs:integer" minOccurs="0"/>
          <xs:element name="NoOfDecimalsIsExtensible" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="Scale" type="xs:integer" minOccurs="0"/>
          <xs:element name="FormatMST" type="xs:string" minOccurs="0"/>
          <xs:element name="AutoInsSeparator" type="xs:string" minOccurs="0"/>
          <xs:element name="ThousandSeparator" type="xs:string" minOccurs="0"/>
          <xs:element name="DecimalSeparator" type="xs:string" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtInt64">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="FormHelp" type="xs:string" minOccurs="0"/>
          <xs:element name="AllowNegative" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="CollectionLabel" type="xs:string" minOccurs="0"/>
          <xs:element name="ShowZero" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="PresenceMethod" type="xs:string" minOccurs="0"/>
          <xs:element name="PresenceClass" type="xs:string" minOccurs="0"/>
          <xs:element name="Alignment" type="xs:string" minOccurs="0"/>
          <xs:element name="ControlClass" type="xs:string" minOccurs="0"/>
          <xs:element name="EnforceHierarchy" type="AxBooleanLikeType" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtInt">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="AllowNegative" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="ShowZero" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="Alignment" type="xs:string" minOccurs="0"/>
          <xs:element name="SignDisplay" type="xs:string" minOccurs="0"/>
          <xs:element name="FormHelp" type="xs:string" minOccurs="0"/>
          <xs:element name="DisplaceNegative" type="xs:string" minOccurs="0"/>
          <xs:element name="RotateSign" type="xs:string" minOccurs="0"/>
          <xs:element name="Tags" type="xs:string" minOccurs="0"/>
          <xs:element name="Direction" type="xs:string" minOccurs="0"/>
          <xs:element name="EnforceHierarchy" type="AxBooleanLikeType" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtDate">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="ButtonImage" type="xs:string" minOccurs="0"/>
          <xs:element name="DateYear" type="xs:string" minOccurs="0"/>
          <xs:element name="DateDay" type="xs:string" minOccurs="0"/>
          <xs:element name="MaxDateLabel" type="xs:string" minOccurs="0"/>
          <xs:element name="DateMonth" type="xs:string" minOccurs="0"/>
          <xs:element name="DateSeparator" type="xs:string" minOccurs="0"/>
          <xs:element name="FormHelp" type="xs:string" minOccurs="0"/>
          <xs:element name="Alignment" type="xs:string" minOccurs="0"/>
          <xs:element name="PresenceIndicatorAllowed" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="DateFormat" type="xs:string" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtUtcDateTime">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="ButtonImage" type="xs:string" minOccurs="0"/>
          <xs:element name="TimeSeconds" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="TimeHours" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="TimeMinute" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="MaxDateLabel" type="xs:string" minOccurs="0"/>
          <xs:element name="DateYear" type="xs:string" minOccurs="0"/>
          <xs:element name="DateDay" type="xs:string" minOccurs="0"/>
          <xs:element name="DateMonth" type="xs:string" minOccurs="0"/>
          <xs:element name="EnforceHierarchy" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="DateSeparator" type="xs:string" minOccurs="0"/>
          <xs:element name="TimezonePreference" type="xs:string" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtContainer">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="ButtonImage" type="xs:string" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtGuid">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="EnforceHierarchy" type="AxBooleanLikeType" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtTime">
    <xs:complexContent>
      <xs:extension base="AxEdtBaseType">
        <xs:all>
          <xs:element name="TimeSeconds" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="TimeHours" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="TimeMinute" type="AxBooleanLikeType" minOccurs="0"/>
          <xs:element name="TimeSeparator" type="xs:string" minOccurs="0"/>
          <xs:element name="TimeFormat" type="xs:string" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AxEdtInvalidType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
    <xs:assert
      test="false()"
      xerces:message="Invalid or missing xsi:type on AxEdt. Allowed types: AxEdtString, AxEdtEnum, AxEdtReal, AxEdtInt64, AxEdtInt, AxEdtDate, AxEdtUtcDateTime, AxEdtContainer, AxEdtGuid, AxEdtTime."/>
  </xs:complexType>

  <xs:element name="AxEdt">
    <xs:alternative test="@xsi:type = 'AxEdtString'" type="AxEdtString"/>
    <xs:alternative test="@xsi:type = 'AxEdtEnum'" type="AxEdtEnum"/>
    <xs:alternative test="@xsi:type = 'AxEdtReal'" type="AxEdtReal"/>
    <xs:alternative test="@xsi:type = 'AxEdtInt64'" type="AxEdtInt64"/>
    <xs:alternative test="@xsi:type = 'AxEdtInt'" type="AxEdtInt"/>
    <xs:alternative test="@xsi:type = 'AxEdtDate'" type="AxEdtDate"/>
    <xs:alternative test="@xsi:type = 'AxEdtUtcDateTime'" type="AxEdtUtcDateTime"/>
    <xs:alternative test="@xsi:type = 'AxEdtContainer'" type="AxEdtContainer"/>
    <xs:alternative test="@xsi:type = 'AxEdtGuid'" type="AxEdtGuid"/>
    <xs:alternative test="@xsi:type = 'AxEdtTime'" type="AxEdtTime"/>
    <xs:alternative type="AxEdtInvalidType"/>
  </xs:element>

</xs:schema>
