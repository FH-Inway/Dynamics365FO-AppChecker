<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      Shared simple types used by both AxEdt.1.0.xsd and AxEdt.1.1.xsd.
      Keep this file limited to XSD 1.0-compatible constructs so it can be
      included from both schema versions.
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="AxYesNoType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Yes"/>
      <xs:enumeration value="No"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxTrueFalseType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxAlignmentType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Center"/>
      <xs:enumeration value="Left"/>
      <xs:enumeration value="Right"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxChangeCaseType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LowerCase"/>
      <xs:enumeration value="None"/>
      <xs:enumeration value="UpperCase"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxDateDayType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Digits2"/>
      <xs:enumeration value="Digits1or2"/>
      <xs:enumeration value="None"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxDateMonthType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Digits2"/>
      <xs:enumeration value="Digits1or2"/>
      <xs:enumeration value="Short"/>
      <xs:enumeration value="Long"/>
      <xs:enumeration value="None"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxDateSeparatorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Slash_Slash"/>
      <xs:enumeration value="Slash_Dash"/>
      <xs:enumeration value="Slash_Dot"/>
      <xs:enumeration value="Slash_Space"/>
      <xs:enumeration value="Slash_None"/>
      <xs:enumeration value="Dash_Slash"/>
      <xs:enumeration value="Dash_Dash"/>
      <xs:enumeration value="Dash_Dot"/>
      <xs:enumeration value="Dash_Space"/>
      <xs:enumeration value="Dash_None"/>
      <xs:enumeration value="Dot_Slash"/>
      <xs:enumeration value="Dot_Dash"/>
      <xs:enumeration value="Dot_Dot"/>
      <xs:enumeration value="Dot_Space"/>
      <xs:enumeration value="Dot_None"/>
      <xs:enumeration value="Space_Slash"/>
      <xs:enumeration value="Space_Dash"/>
      <xs:enumeration value="Space_Dot"/>
      <xs:enumeration value="Space_Space"/>
      <xs:enumeration value="Space_None"/>
      <xs:enumeration value="None_Slash"/>
      <xs:enumeration value="None_Dash"/>
      <xs:enumeration value="None_Dot"/>
      <xs:enumeration value="None_Space"/>
      <xs:enumeration value="None_None"/>
      <xs:enumeration value="ChineseFormal"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxDateYearType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Digits2"/>
      <xs:enumeration value="Digits4"/>
      <xs:enumeration value="None"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxDateFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DMY"/>
      <xs:enumeration value="YMD"/>
      <xs:enumeration value="YDM"/>
      <xs:enumeration value="MYD"/>
      <xs:enumeration value="DYM"/>
      <xs:enumeration value="MDY"/>
      <xs:enumeration value="DMY"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxDecimalSeparatorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Comma"/>
      <xs:enumeration value="Dot"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxDirectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LTR"/>
      <xs:enumeration value="RTL"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxSignDisplayType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None"/>
      <xs:enumeration value="Parentheses"/>
      <xs:enumeration value="Prefixed"/>
      <xs:enumeration value="Suffixed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxStyleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Combobox"/>
      <xs:enumeration value="Radiobutton"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxThousandSeparatorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None"/>
      <xs:enumeration value="Comma"/>
      <xs:enumeration value="Dot"/>
      <xs:enumeration value="Space"/>
      <xs:enumeration value="Apostrophe"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxTimeFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Hour24"/>
      <xs:enumeration value="AMPM"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxTimeSeparatorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Colon"/>
      <xs:enumeration value="Dot"/>
      <xs:enumeration value="Space"/>
      <xs:enumeration value="Comma"/>
      <xs:enumeration value="Slash"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxAdjustmentType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Right"/>
      <xs:enumeration value="Left"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AxTimezonePreferenceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NoConversion"/>
      <xs:enumeration value="User"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
